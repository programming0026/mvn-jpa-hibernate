<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="demo" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.juniverse.jpa.entity.AppUser</class>
        <class>com.juniverse.jpa.entity.Profile</class>
        <class>com.juniverse.jpa.entity.Address</class>
        <class>com.juniverse.jpa.entity.Department</class>
        <class>com.juniverse.jpa.entity.Employee</class>
        <class>com.juniverse.jpa.entity.Student</class>
        <class>com.juniverse.jpa.entity.Course</class>
        <class>com.juniverse.jpa.entity.Product</class>
        <class>com.juniverse.jpa.entity.PurchaseOrder</class>
        <class>com.juniverse.jpa.entity.OrderItem</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- H2 en memoria: se crea al arrancar y desaparece al cerrar -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:demo;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <!-- Hibernate crea las tablas a partir de las entidades y las borra al terminar -->
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <!-- Estadísticas para contar las sentencias SQL (demostración del problema N+1) -->
            <property name="hibernate.generate_statistics" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
